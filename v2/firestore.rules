rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Lectura pública para la afición en index.html
    // Escritura exclusiva para el administrador autenticado en admin.html
    match /leagues/{leagueId} {
      allow read: if true;
      allow write: if request.auth != null;

      match /{collectionName}/{docId} {
        allow read: if true;
        allow write: if request.auth != null;
      }
    }
  }
}
